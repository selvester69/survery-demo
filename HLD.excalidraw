    },
    {
      "id": "Srp7yFHRBTUnS8rONS9R7",
      "type": "text",
      "x": -509.1613483906631,
      "y": 164.07752573668222,
      "width": 572.9195556640625,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1513356871,
      "version": 956,
      "versionNonce": 1386397127,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770007299468,
      "link": null,
      "locked": false,
      "text": "Fn req: Admin\nadmin UI -> create new questions and save in question db \nquestions table -> question id for reuse \nsurvey table -> saves survey group id \nadmin create new survey and save\non save -> new tiny URL generated.\n\nFn Req: User\nSurvey UI -> fill survey and submit \non submit ->  survery people table -> each survey data.\n\n\n\n\nScale:\ndata -> total population -> 150 billion \nsimilar survey type-> group to 100 million total \n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fn req: Admin\nadmin UI -> create new questions and save in question db \nquestions table -> question id for reuse \nsurvey table -> saves survey group id \nadmin create new survey and save\non save -> new tiny URL generated.\n\nFn Req: User\nSurvey UI -> fill survey and submit \non submit ->  survery people table -> each survey data.\n\n\n\n\nScale:\ndata -> total population -> 150 billion \nsimilar survey type-> group to 100 million total \n",
      "autoResize": true,
      "lineHeight": 1.25
    },
